<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Editar {{ equipo.nombre }} - Champion Calendar</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body, html {
            background: linear-gradient(to right, #f4791f, #659999);
            height: 100%;
            margin: 0;
            font-family: Arial, sans-serif;
        }

        .container {
            height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .edit-card {
            background-color: white;
            padding: 40px;
            border-radius: 15px;
            box-shadow: 0px 4px 8px rgba(0, 0, 0, 0.1);
            width: 100%;
            max-width: 500px;
        }

        .edit-card h1 {
            font-size: 2rem;
            margin-bottom: 20px;
            color: #007bff;
            text-align: center;
        }

        .form-control {
            border-radius: 25px;
            padding: 15px;
            margin-bottom: 15px;
            color: #333;
            background-color: #f9f9f9;
            border: 1px solid #ccc;
        }

        .btn-primary {
            background-color: #007bff;
            border-color: #007bff;
            padding: 15px;
            font-size: 1.25rem;
            width: 100%;
        }

        .btn-primary:hover {
            background-color: #0056b3;
            border-color: #0056b3;
        }

        .alert {
            font-size: 14px;
            margin-bottom: 15px;
        }

        .btn-secondary {
            width: 100%;
            margin-top: 10px;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="edit-card">
            <h1>Editar {{ equipo.nombre }}</h1>

            {% if session['mensaje'] is defined %}
                <div class="alert alert-success">
                    {{ session['mensaje'] }}
                </div>
            {% endif %}

            {% if session['mensaje_error'] is defined %}
                <div class="alert alert-danger">
                    {{ session['mensaje_error'] }}
                </div>
            {% endif %}

            <form action="/equipos/{{ equipo.id }}/editar" method="POST">
                <div class="mb-3">
                    <label for="nombre" class="form-label">Nombre del Equipo</label>
                    <input type="text" class="form-control" id="nombre" name="nombre" value="{{ equipo.nombre }}" required>
                </div>
                <div class="mb-3">
                    <label for="pais" class="form-label">País</label>
                    <input type="text" class="form-control" id="pais" name="pais" value="{{ equipo.pais }}" required>
                </div>
                <div class="mb-3">
                    <label for="estadio" class="form-label">Estadio</label>
                    <input type="text" class="form-control" id="estadio" name="estadio" value="{{ equipo.estadio }}" required>
                </div>
                <div class="mb-3">
                    <label for="url_imagen" class="form-label">URL de Imagen</label>
                    <input type="text" class="form-control" id="url_imagen" name="url_imagen" value="{{ equipo.url_imagen }}" required>
                </div>
                <button type="submit" class="btn btn-primary">Guardar Cambios</button>
            </form>

            <a href="/equipos" class="btn btn-secondary">Volver</a>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
