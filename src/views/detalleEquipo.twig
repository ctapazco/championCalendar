<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ equipo.nombre }} - Champion Calendar</title>
    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        /* Fondo general */
        body {
            background: linear-gradient(to right, #f8f9fa, #e3f2fd);
            color: #333;
        }

        /* Contenedor principal */
        .container {
            background: #ffffff;
            padding: 20px;
            border-radius: 15px;
            box-shadow: 0px 0px 15px rgba(0, 0, 0, 0.1);
        }

        /* Card del equipo */
        .team-card {
            background: #ffffff;
            border-radius: 12px;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
        }

        /* Banner del equipo */
        .team-banner {
            width: 100%;
            height: 300px;
            background-image: url('{{ equipo.url_imagen }}');
            background-size: cover;
            background-position: center;
            border-radius: 12px 12px 0 0;
        }

        /* Estilo para tablas */
        .table {
            background: #ffffff;
            border-radius: 10px;
            overflow: hidden;
        }
        .table-hover tbody tr:hover {
            background: rgba(0, 123, 255, 0.1);
        }

        /* Mejorar visibilidad de títulos */
        h3 {
            color: #007bff;
            font-weight: bold;
            text-align: center;
        }

        /* Botones */
        .btn-lg {
            font-size: 18px;
            font-weight: bold;
            padding: 12px;
            transition: all 0.3s ease-in-out;
        }
        .btn-lg:hover {
            transform: scale(1.05);
            opacity: 0.9;
        }

        /* Contenedor de la gráfica */
        #grafica-container {
            display: none;
            padding: 20px;
            background: #ffffff;
            border-radius: 12px;
            margin-top: 20px;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
        }

    </style>
</head>
<body>
    <div class="container mt-4">
        <!-- Card con información del equipo -->
        <div class="row">
            <div class="col-md-4">
                <div class="card team-card">
                    <div class="team-banner"></div>
                    <div class="card-body text-center">
                        <h5 class="card-title">{{ equipo.nombre }}</h5>
                        <p class="card-text"><strong>🏟 Estadio:</strong> {{ equipo.estadio }}</p>
                        <p class="card-text"><strong>🌍 País:</strong> {{ equipo.pais }}</p>

                        <a href="/equipos" class="btn btn-primary btn-lg w-100">⬅️ Volver a la lista</a>
                    </div>
                </div>
            </div>

            <div class="col-md-8">
                <!-- Tabla de los partidos -->
                <h3>📅 Partidos del equipo</h3>
                <table class="table table-hover table-bordered">
                    <thead class="table-primary">
                        <tr>
                            <th>Fecha</th>
                            <th>Hora</th>
                            <th>Local</th>
                            <th>Visitante</th>
                            <th>Resultado</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for partido in encuentros %}
                            <tr>
                                <td>{{ partido.fecha }}</td>
                                <td>{{ partido.hora }}</td>
                                <td>{{ partido.equipo_local }}</td>
                                <td>{{ partido.equipo_visitante }}</td>
                                <td>{{ partido.resultado_local }} - {{ partido.resultado_visitante }}</td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="5" class="text-center">No hay partidos disponibles</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Tabla de jugadores -->
        <div class="mt-4">
            <h3>⚽ Plantilla de Jugadores</h3>
            <table class="table table-hover table-bordered">
                <thead class="table-warning">
                    <tr>
                        <th>Nombre</th>
                        <th>Edad</th>
                        <th>Dorsal</th>
                        <th>Minutos Jugados</th>
                        <th>Goles</th>
                        <th>Asistencias</th>
                        <th>Tarjetas Amarillas</th>
                        <th>Tarjetas Rojas</th>
                    </tr>
                </thead>
                <tbody>
                    {% for jugador in jugadores %}
                        <tr>
                            <td>{{ jugador.nombre }}</td>
                            <td>{{ jugador.edad }}</td>
                            <td>{{ jugador.dorsal }}</td>
                            <td>{{ jugador.minutos_jugados }}</td>
                            <td>{{ jugador.goles }}</td>
                            <td>{{ jugador.asistencias }}</td>
                            <td>{{ jugador.tarjetas_amarillas }}</td>
                            <td>{{ jugador.tarjetas_rojas }}</td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="8" class="text-center">No hay jugadores disponibles.</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>

            <!-- Botón para mostrar la gráfica -->
            <button class="btn btn-success btn-lg w-100" onclick="mostrarGrafica()">📊 Ver Estadísticas</button>

            <!-- Contenedor de la gráfica -->
            <div id="grafica-container">
                <canvas id="grafica-jugadores"></canvas>
            </div>
        </div>
    </div>

    <!-- Incluir Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
   function mostrarGrafica() {
    var graficaContainer = document.getElementById("grafica-container");

    // Si el gráfico ya está visible, lo oculta; si no, lo muestra
    if (graficaContainer.style.display === "block") {
        graficaContainer.style.display = "none";
    } else {
        graficaContainer.style.display = "block";

        var ctx = document.getElementById('grafica-jugadores').getContext('2d');

        var jugadores = [
            {% for jugador in jugadores %}
                {
                    nombre: "{{ jugador.nombre }}",
                    minutos: {{ jugador.minutos_jugados }},
                    goles: {{ jugador.goles }},
                    asistencias: {{ jugador.asistencias }},
                    amarillas: {{ jugador.tarjetas_amarillas }},
                    rojas: {{ jugador.tarjetas_rojas }}
                },
            {% endfor %}
        ];

        new Chart(ctx, {
            type: 'bar',
            data: {
                labels: jugadores.map(j => j.nombre),
                datasets: [
                    { label: 'Minutos Jugados', data: jugadores.map(j => j.minutos), backgroundColor: '#17a2b8' },
                    { label: 'Goles', data: jugadores.map(j => j.goles), backgroundColor: '#dc3545' },
                    { label: 'Asistencias', data: jugadores.map(j => j.asistencias), backgroundColor: '#28a745' },
                    { label: 'Tarjetas Amarillas', data: jugadores.map(j => j.amarillas), backgroundColor: '#ffc107' },
                    { label: 'Tarjetas Rojas', data: jugadores.map(j => j.rojas), backgroundColor: '#6c757d' }
                ]
            },
            options: { responsive: true, scales: { y: { beginAtZero: true } } }
        });
    }
}

    </script>
</body>
</html>
